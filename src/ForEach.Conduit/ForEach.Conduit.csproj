<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <!-- NuGet package metadata -->
    <PropertyGroup>
        <PackageId>ForEach.Conduit</PackageId>
        <Version>1.0.0</Version>
        <Authors>Milan Kostadinovic</Authors>
        <Description>
            A lightweight, allocation-efficient CQRS mediator for .NET.
            Features zero-reflection hot paths (wrapper pattern), railway-oriented ValueResult types,
            composable pipeline behaviors, notifications with fan-out, streaming queries,
            and built-in OpenTelemetry support.
        </Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageTags>cqrs;mediator;commands;queries;notifications;streaming;opentelemetry;railway;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/foreach-rs/foreach-conduit</RepositoryUrl>
        <PackageProjectUrl>https://github.com/foreach-rs/foreach-conduit</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Resilience"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')"/>
    </ItemGroup>

</Project>
